# All optional. Every adapter degrades to a documented fallback when its key is absent.

# Transit routing. Without this, transit legs fall back to a generated guidance card.
TRANSIT_PROVIDER=
TRANSIT_API_KEY=

# Tier 2/3 card prose. Without this, the deterministic provider is used.
LLM_PROVIDER=
LLM_API_KEY=

# Contact address sent in the User-Agent to Photon/Nominatim, per their usage policy.
GEOCODER_CONTACT=
