# ---- Frontend (safe to expose; these ship in the browser bundle) ----
# Leave BOTH blank to run entirely locally: no account, nothing shared. That is
# a supported mode, and the build swaps the Supabase client for a stub so the
# bundle stays ~52kB instead of ~270kB.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ---- Admin access for scripts/db.mjs (migrations + ad-hoc SQL) ----
# Just the password; host, port and user are derived from PUBLIC_SUPABASE_URL.
# This one IS a real secret: full database access, bypasses RLS entirely.
SUPABASE_DB_PASSWORD=

# Only needed to CREATE the Supabase project. Delete the line once it exists;
# nothing in the app or the deploy reads it.
# SUPABASE_ACCESS_TOKEN=

# ---- Wanderlog sync (never stored server-side; see docs/WANDERLOG.md) ----
# WANDERLOG_SESSION=
# SUPABASE_REFRESH_TOKEN=
