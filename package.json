{
  "name": "trip-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turns an itinerary into an enriched trip graph and renders it as a shareable, printable briefing.",
  "scripts": {
    "brief": "node src/cli.ts",
    "serve": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.sw.json",
    "build:web": "node scripts/build-web.ts",
    "preview:web": "node scripts/build-web.ts && node --run serve:dist",
    "serve:dist": "node scripts/serve-dist.ts",
    "review": "node scripts/review.ts",
    "sync": "node scripts/sync-wanderlog.ts",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:query": "node scripts/db.mjs query",
    "import:restroom": "node scripts/import-restroom.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "dependencies": {
    "@minormending/map-kit": "github:minormending/map-kit",
    "@supabase/supabase-js": "^2.116.0"
  }
}
